# ==============================================================================
# Arzi Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: API keys are read STRICTLY by the backend serverless endpoint (/api/analyze)
# and are NEVER bundled into or exposed to browser client code.
# If keys are omitted, Arzi gracefully falls back to realistic canned analysis
# so all features remain testable without external credentials.
# ==============================================================================

# Google Gemini Vision API Key (Recommended)
# Create a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional Alternative)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
